# ============================================================
# JobFinderOS backend environment
# Copy to .env and fill in. Only GLM_API_KEY is needed for AI
# matching — the SAME key you used for TalentHive works here.
# ============================================================

# AI — Z.ai GLM (identical setup to TalentHive)
GLM_API_KEY=your-z-ai-api-key
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.1  # 10x concurrency, ~6s/match, stable scores (4.6: 3x, up to 42-pt run variance)

# Database — SQLite by default (zero config). For Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/jobfinderos
# DATABASE_URL=sqlite:///./jobfinderos.db

# Email applications via Resend (optional — same provider TalentHive used)
# RESEND_API_KEY=your-resend-api-key
# APPLY_FROM_EMAIL=you@yourdomain.com   (must be a verified Resend sender)

# Scraping
SCRAPE_SOURCES=arbeitnow,remotive,jobicy,workingnomads,jobtech,teamtailor,reed
SCRAPE_TIMEOUT_SECONDS=20

# Background scheduler (optional; pipeline can also be triggered manually)
ENABLE_SCHEDULER=false
SCRAPE_INTERVAL_MINUTES=60

# Matching
MAX_JOBS_PER_MATCH_RUN=25

# CORS (frontend origin in dev)
CORS_ORIGINS=*

# Sweden — JobTech / Platsbanken (Arbetsförmedlingen open API)
# Keyless works for light use; free key at https://jobtechdev.se for production:
# JOBTECH_API_KEY=your-jobtech-key
# Per-user queries are set during onboarding (AI derives them from YOUR CV).
# Optional manual override for testing:
# JOBTECH_QUERIES=utvecklare,fullstack

# Sweden — Teamtailor career sites ({slug}.teamtailor.com)
# Add slugs for staffing agencies / employers you want directly:
# TEAMTAILOR_SITES=manpowerse,fortnoxab,academicwork

# UK — Reed.co.uk jobs API (get key via Reed's affiliate/developer program)
# Auth: key goes in REED_API_KEY; sent as basic-auth username with empty password
# REED_API_KEY=your-reed-key
# REED_KEYWORDS=            # empty = all professions
# REED_LOCATION=London
# REED_DISTANCE_MILES=20

# UK — Adzuna jobs API (free keys at https://developer.adzuna.com)
# ADZUNA_APP_ID=your-app-id
# ADZUNA_APP_KEY=your-app-key

# SE + GB — Careerjet aggregator (register at careerjet partners portal)
# CAREERJET_API_KEY=your-careerjet-key
# Composio (Settings -> Integrations). Get a key at composio.dev
COMPOSIO_API_KEY=

# Auth (fastapi-users) — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me
AUTH_TOKEN_LIFETIME_SECONDS=604800

# CV storage backend: local (disk) or supabase (official REST —
# supabase.com/docs/guides/storage/uploads)
STORAGE_BACKEND=local
# SUPABASE_URL=https://YOURPROJECT.supabase.co
# SUPABASE_SERVICE_KEY=service-role-key
# SUPABASE_STORAGE_BUCKET=cvs

# Postgres for production/CI (Neon pooled URL works as-is):
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require
