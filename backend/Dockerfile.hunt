# JobFinderOS hunt image — the ONE-SHOT cron shape (WO-07).
#
# Same layers as the API image; only the CMD differs: run a single
# claim -> hunt -> release cycle and exit. Render cron jobs are billed
# per second of ACTIVE runtime (render.com/docs/cronjobs, $1/mo minimum)
# — a scheduler loop here would bill to the 12-hour run cap. Overlapping
# schedules are already safe: run_scheduled_hunt claims the DB hunt lock
# (WO-04) and Render itself delays a scheduled run while one is active.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# DejaVu core fonts (AI-12) — same layer as the API image: python:3.12-slim
# ships no fonts, so pdf_service.py's unicode fallback found nothing and
# employer-facing PDFs rendered "?" for em-dashes/curly quotes. The package
# provides the first Linux path in FONT_CANDIDATES; lists cleaned in-layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock

# alembic ships: the one-shot cycle calls init_db() first (advisory-lock
# serialized against the API's boot migrations)
COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts

RUN useradd --create-home --uid 10001 jobfinder && chown -R jobfinder /app
USER jobfinder

CMD ["python", "-m", "app.services.worker", "--once"]
